{
  "name": "GT-Vision BETA Development",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "backend",
  // --- LINHA ALTERADA ---
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  // --------------------
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "forwardPorts": [
    8000,
    15672,
    5173
  ],
  "postCreateCommand": "echo 'Ambiente GT-Vision pronto!'",
  "remoteUser": "vscode"
}